# Discord-приложение
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
CLIENT_SECRET=your-application-secret

# Публичный адрес панели (без слэша в конце). Redirect URI = BASE_URL/callback
BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Название по умолчанию
FACTION_NAME=Фракция

# Необязательно: сервер, на котором регистрируются слэш-команды
COMMAND_GUILD_ID=

# Необязательно: ID ролей, дающих доступ к офицерским функциям
OFFICER_ROLE_IDS=

# Необязательно: Discord ID владельцев/администраторов (полный доступ)
ADMIN_IDS=

# Необязательно: ключ подписи cookie сессии (иначе создаётся автоматически в data/)
SESSION_SECRET=

# Необязательно: путь к базе (по умолчанию data/faction.db)
DB_PATH=
